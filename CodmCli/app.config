<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- export paths get long (weapon/models/prefab/anims/clip.cast); let .NET pass them through when Windows allows it -->
    <AppContextSwitchOverrides value="Switch.System.IO.UseLegacyPathHandling=false;Switch.System.IO.BlockLongPaths=false" />
  </runtime>
</configuration>
